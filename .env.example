VITE_API_BASE_URL=http://127.0.0.1:8000

# ONE client UI for MANY client servers (e.g. algo.welthwest.com).
# Comma-separated backend URLs; when set it replaces VITE_API_BASE_URL. At login
# the UI finds the user's own server (GET /auth/home) and talks only to it.
# Every server listed needs CORS_ORIGINS=https://algo.welthwest.com and
# CLIENT_REDIRECT_URI=https://algo.welthwest.com/broker/callback in its .env.
# VITE_API_BASE_URLS=https://api.13-206-102-63.sslip.io,https://api.1-2-3-4.sslip.io
